# Legacy root-level runtime artifacts and local state (current scan outputs live under LOG_DIR).
state.json
config.json
config_data.js
dashboard_data.js

# Legacy root-level dashboard copy; current file:// output is under ~/.codex/logs/mac-dev-cleanup/dashboard/.
dashboard.html

# SkillDo 仓储缓存标记（last_fetched_ms + head，仅本机有效）。skilldo 每次
# update 都会把它写回技能根目录，不忽略就会被 push 提交进公开仓库。
.skilldo-cache.json

# 备份
*.bak.*
scripts/*.bak*

# Python 缓存
__pycache__/
*.pyc

# 已弃用的 vendor（dashboard 已改为零依赖内联 vanilla，不再引用）
vendor/

# 本地会话记忆（WorkBuddy 工作目录，不入库）。写成无斜杠形式：实体已迁到
# ~/.codex/logs/mac-dev-cleanup/.workbuddy/，技能目录内只留软链，而带斜杠的
# pattern 只匹配目录、不会忽略软链——那会把本地绝对路径写进公开仓库。
.workbuddy

# Node 依赖（jsdom 仅 DOM 校验脚本用，本地 npm i 即可，不入库）
node_modules/

# SkillDo 包构建时的临时目录，不包含权威 Skill 内容。
skills/.mac-dev-cleanup-stage-*/
skills/.mac-dev-cleanup.previous/
